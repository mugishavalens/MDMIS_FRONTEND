# Copy this file to .env.local and fill in your own values.
# Never commit .env.local — it is listed in .gitignore.

# Mapbox public token — https://mapbox.com (kept for fallback)
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your_token_here

# Cesium Ion token — https://ion.cesium.com (free account)
# Used for Cesium World Terrain (global elevation) + Bing satellite imagery
NEXT_PUBLIC_CESIUM_TOKEN=your_cesium_ion_token_here

# MDMIS Django backend (see ../backend). Defaults to the local dev server.
NEXT_PUBLIC_API_URL=http://localhost:8002/api
